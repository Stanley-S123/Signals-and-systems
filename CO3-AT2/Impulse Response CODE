clc;
clear;
close;

//-------------------------------------
// Time Vector
//-------------------------------------
dt = 0.001;
t = 0:dt:5;

//-------------------------------------
// Input Signal x(t)
//-------------------------------------
x = exp(-2*t);

//-------------------------------------
// Impulse Response h(t)
//-------------------------------------
h = exp(-3*t);

//-------------------------------------
// Numerical Convolution
//-------------------------------------
y_num = convol(x,h)*dt;

// Time axis for convolution result
t_conv = 0:dt:(length(y_num)-1)*dt;

//-------------------------------------
// Analytical Result
//-------------------------------------
y_ana = exp(-2*t_conv) - exp(-3*t_conv);

//-------------------------------------
// Plotting
//-------------------------------------
scf(1);

subplot(3,1,1);
plot(t,x);
xtitle("Input Signal x(t)=e^{-2t}u(t)");
xlabel("Time (s)");
ylabel("Amplitude");
xgrid();

subplot(3,1,2);
plot(t,h);
xtitle("Impulse Response h(t)=e^{-3t}u(t)");
xlabel("Time (s)");
ylabel("Amplitude");
xgrid();

subplot(3,1,3);
plot(t_conv,y_num,'b');
plot(t_conv,y_ana,'r--');

legend("Numerical Convolution","Analytical Result");

xtitle("Output y(t)");
xlabel("Time (s)");
ylabel("Amplitude");
xgrid();

//-------------------------------------
// Error Verification
//-------------------------------------
error = max(abs(y_num - y_ana));

disp("Maximum Error = ");
disp(error);
