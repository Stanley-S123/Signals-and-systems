clc;
clear;
close;

// Define Laplace variable
s = poly(0,'s');

// Transfer Function H(s) = 8/(s^2 + 6s + 8)
H = syslin('c', 8/(s^2 + 6*s + 8));

// Time vector
t = 0:0.01:10;

// Unit step input response
y = csim('step', t, H);

// Plot response
plot(t,y,'b','LineWidth',2);
xlabel('Time (seconds)');
ylabel('Capacitor Voltage Vc(t)');
title('Step Response of Series RLC Circuit');
xgrid();

// System characteristics
info = stepinfo(y,t);

disp("Rise Time (s) = ");
disp(info.RiseTime);

disp("Settling Time (s) = ");
disp(info.SettlingTime);

disp("Overshoot (%) = ");
disp(info.Overshoot);
