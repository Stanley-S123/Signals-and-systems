clc;
clear;
close;

//--------------------------------------------------
// Define Transfer Function
//--------------------------------------------------
s = poly(0,'s');

num = 10*(s+1);
den = (s+2)*(s+5);

H = syslin('c', num/den);

//--------------------------------------------------
// Display Numerator and Denominator
//--------------------------------------------------
disp("Numerator Polynomial:");
disp(num);

disp("Denominator Polynomial:");
disp(den);

//--------------------------------------------------
// Partial Fraction Expansion
//--------------------------------------------------
disp("Partial Fraction Expansion:");

r = residu([10 10],[1 7 10]);

disp("Residues:");
disp(r);

//--------------------------------------------------
// Time Vector
//--------------------------------------------------
t = 0:0.01:5;

//--------------------------------------------------
// Impulse Response
//--------------------------------------------------
h = csim('impulse',t,H);

//--------------------------------------------------
// Step Response
//--------------------------------------------------
y = csim('step',t,H);

//--------------------------------------------------
// Plot Responses
//--------------------------------------------------
scf(1);

subplot(2,1,1);
plot(t,h);
title("Impulse Response");
xlabel("Time (s)");
ylabel("h(t)");
xgrid();

subplot(2,1,2);
plot(t,y);
title("Step Response");
xlabel("Time (s)");
ylabel("y(t)");
xgrid();

//--------------------------------------------------
// Theoretical Time Constants
//--------------------------------------------------
tau1 = 1/2;
tau2 = 1/5;

disp("Time Constant tau1 = ");
disp(tau1);

disp("Time Constant tau2 = ");
disp(tau2);

//--------------------------------------------------
// Poles
//--------------------------------------------------
poles = roots(den);

disp("System Poles:");
disp(poles);
